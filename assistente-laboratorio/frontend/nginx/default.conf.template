server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # CSP, nosniff e Referrer-Policy (sicurezza.conf): qui valgono per /api/, che non ha
    # add_header propri; ogni location con un suo add_header le include di nuovo.
    include /etc/nginx/sicurezza.conf;

    # Il back-end ha il nome BACKEND_INDIRIZZO nella rete di Compose (backend; le prove del
    # browser lo puntano all'host). Con proxy_pass a una variabile nginx risolve il nome
    # a ogni richiesta con il DNS di Docker: parte anche se il back-end è spento, e dà 502
    # finché non risponde. Con una variabile l'URI non si sostituisce: la rewrite toglie /api.
    # Niente buffering: gli eventi SSE devono arrivare uno alla volta.
    location /api/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $backend http://${BACKEND_INDIRIZZO}:${BACKEND_PORTA};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    # File compilati con nome che cambia a ogni modifica: cache lunga.
    location /assets/ {
        include /etc/nginx/sicurezza.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # File che il browser deve riscaricare sempre (aggiornamento dell'app e del service worker).
    location = /index.html {
        include /etc/nginx/sicurezza.conf;
        add_header Cache-Control "no-cache";
    }
    location = /sw.js {
        include /etc/nginx/sicurezza.conf;
        add_header Cache-Control "no-cache";
    }
    location = /manifest.webmanifest {
        include /etc/nginx/sicurezza.conf;
        add_header Cache-Control "no-cache";
    }

    # Tutto il resto è la chat: fallback a index.html.
    location / {
        include /etc/nginx/sicurezza.conf;
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
