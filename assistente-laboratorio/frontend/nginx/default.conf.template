# max_fails=0: nginx non mette da parte il back-end dopo un errore, così al riavvio risponde subito.
upstream backend {
    server host.docker.internal:${BACKEND_PORTA} max_fails=0;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # CSP, nosniff e Referrer-Policy (sicurezza.conf): qui valgono per /api/, che non ha
    # add_header propri; ogni location con un suo add_header le include di nuovo.
    include /etc/nginx/sicurezza.conf;

    # Il back-end gira sull'host (solo su 127.0.0.1); si toglie il prefisso /api.
    # Niente buffering: gli eventi SSE devono arrivare uno alla volta.
    location /api/ {
        proxy_pass http://backend/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    # File compilati con nome che cambia a ogni modifica: cache lunga.
    location /assets/ {
        include /etc/nginx/sicurezza.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # File che il browser deve riscaricare sempre (aggiornamento dell'app e del service worker).
    location = /index.html {
        include /etc/nginx/sicurezza.conf;
        add_header Cache-Control "no-cache";
    }
    location = /sw.js {
        include /etc/nginx/sicurezza.conf;
        add_header Cache-Control "no-cache";
    }
    location = /manifest.webmanifest {
        include /etc/nginx/sicurezza.conf;
        add_header Cache-Control "no-cache";
    }

    # Tutto il resto è la chat: fallback a index.html.
    location / {
        include /etc/nginx/sicurezza.conf;
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
