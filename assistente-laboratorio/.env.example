# Copia questo file in .env e adatta i valori. Nessuna credenziale necessaria.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_BASE_URL_DOCKER=http://host.docker.internal:1234/v1
# Identificativo restituito da GET /v1/models
LMSTUDIO_MODEL=google/gemma-4-e2b
# Riserva manuale se il fuso non viene rilevato
FUSO_ORARIO=Europe/Rome
# Porta locale del server MCP avviato dall'assistente (intero tra 1024 e 65535)
MCP_PORTA=8765
# Variante della calcolatrice vista dal modello: mcp (server MCP) oppure locale (@tool nell'assistente)
VARIANTE_CALCOLATRICE=mcp
# Variante di calcola_scadenza vista dal modello: mcp (server MCP) oppure fastapi (servizio HTTP + wrapper)
VARIANTE_SCADENZE=mcp
# Porta locale del servizio FastAPI, usata solo con VARIANTE_SCADENZE=fastapi (diversa da MCP_PORTA)
API_PORTA=8766
# Porta locale del servizio HTTP dell'agente (python -m servizio_agente), diversa da MCP_PORTA e API_PORTA
AGENTE_PORTA=8767
# Indirizzo su cui ascolta il servizio dell'agente: facoltativo, predefinito 127.0.0.1 (in Docker lo imposta Compose a 0.0.0.0)
# AGENTE_HOST=127.0.0.1
# Porta locale del back-end delle chat (python -m servizio_backend), diversa da MCP_PORTA, API_PORTA e AGENTE_PORTA
BACKEND_PORTA=8768
# Utente di PostgreSQL
POSTGRES_USER=assistente
# Nome del database di PostgreSQL
POSTGRES_DB=assistente
# Scegli una password: resta solo nel tuo .env
POSTGRES_PASSWORD=
# Porta locale di PostgreSQL (facoltativa, predefinita 5432)
POSTGRES_PORTA=5432
# Porta locale della chat nel browser (container frontend), facoltativa, predefinita 8780
FRONTEND_PORTA=8780
